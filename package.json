{
  "name": "@brains/a11y",
  "version": "1.0.0",
  "private": false,
  "description": "The BRAINS accessibility standard \u2014 eight viewing-preference axes, one implementation, shared across every Shard and BRAINS surface.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BRAINS-Certified/BRAINS-A11Y.git"
  },
  "exports": {
    ".": "./core/index.mjs",
    "./core": "./core/index.mjs",
    "./core/no-flash": "./core/no-flash.mjs",
    "./react": "./react/index.jsx",
    "./astro/NoFlash.astro": "./astro/NoFlash.astro",
    "./astro/A11yPanel.astro": "./astro/A11yPanel.astro",
    "./tokens/base.css": "./tokens/base.css",
    "./tokens/shard.css": "./tokens/shard.css",
    "./tokens/brains.css": "./tokens/brains.css",
    "./tokens/panel.css": "./tokens/panel.css",
    "./dist/brains-a11y.js": "./dist/brains-a11y.js",
    "./core/icons": "./core/icons.mjs",
    "./core/keyboard": "./core/keyboard.mjs",
    "./core/reading-guide": "./core/reading-guide.mjs",
    "./astro/A11yTrigger.astro": "./astro/A11yTrigger.astro",
    "./tokens/trigger.css": "./tokens/trigger.css"
  },
  "files": [
    "core",
    "react",
    "astro",
    "tokens",
    "dist",
    "assets",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-iife.mjs && node scripts/build-icons.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "npm run check:contrast && npm test && npm run build",
    "test:browser": "node test/browser/build-fixture.mjs && node test/browser/axes.spec.mjs",
    "test:axe": "node test/browser/build-fixture.mjs && node test/browser/axe.spec.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "neurodiversity",
    "dyslexia",
    "low-vision",
    "design-system",
    "preferences",
    "brains"
  ]
}
